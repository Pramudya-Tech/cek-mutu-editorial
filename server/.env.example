# Copy this file to server/.env and fill it in.

# Your OJS 3.3 database (MySQL/MariaDB). A read-only user is recommended:
#   CREATE USER 'cekmutu_ro'@'localhost' IDENTIFIED BY 'choose-a-password';
#   GRANT SELECT ON ojs.* TO 'cekmutu_ro'@'localhost';
OJS_DB_URL=mysql://cekmutu_ro:choose-a-password@localhost:3306/ojs

# Or leave OJS_DB_URL empty and point to OJS's own config file instead:
# OJS_CONFIG=C:/xampp/htdocs/ojs/config.inc.php

# Where the app keeps its own tables (checklists, PDFs, signatures).
# Default is a SQLite file in server/instance/. For a shared server use a separate MySQL database:
# APP_DB_URL=mysql://cekmutu:another-password@localhost:3306/cekmutu
APP_DB_URL=

# OJS base address up to index.php, used for "Buka di OJS" links (optional).
OJS_URL=http://localhost/ojs/index.php

HOST=127.0.0.1
PORT=5000
# Set to 1 when served over HTTPS.
SECURE_COOKIE=0
# Leave empty to generate one automatically in server/instance/secret.key
SECRET_KEY=
